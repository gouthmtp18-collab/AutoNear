{
  "rules": {
    // ── Admin Nodes ──────────────────────────────────────────────────────────
    // Only admins can read the admin list.
    // Admin status can only be written by the Firebase console or a trusted
    // server-side process (e.g., Admin SDK via Cloud Functions).
    // Never allow users to grant themselves admin status.
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },

    // ── User Profiles ────────────────────────────────────────────────────────
    "users": {
      "$uid": {
        // Users can read and write only their own profile
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','email','role','createdAt'])",
        "uid":       { ".validate": "newData.val() === auth.uid" },
        "email":     { ".validate": "newData.isString() && newData.val().length > 0" },
        "role":      { ".validate": "newData.val() === 'passenger' || newData.val() === 'driver'" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      },
      // Admins can read all user profiles
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    // ── Driver Profiles ──────────────────────────────────────────────────────
    "drivers": {
      // Admins can read and write all driver profiles
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",

      "$uid": {
        // Drivers can read their own profile
        ".read": "auth != null && auth.uid === $uid",

        // New profile creation: driver creating their own profile (pending only)
        // Profile updates: only admins can change approvalStatus
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",

        ".validate": "newData.hasChildren(['uid','email','fullName','phone','vehicleRegNumber','approvalStatus','createdAt','updatedAt'])",

        "uid":               { ".validate": "newData.val() === $uid" },
        "email":             { ".validate": "newData.isString() && newData.val().length > 3" },
        "fullName":          { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
        "phone":             { ".validate": "newData.isString() && newData.val().length >= 10" },
        "vehicleRegNumber":  { ".validate": "newData.isString() && newData.val().length >= 6" },
        "approvalStatus":    {
          ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected' || newData.val() === 'suspended'",
          // Non-admins can only set 'pending' (on first creation)
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || newData.val() === 'pending')"
        },
        "createdAt":         { ".validate": "newData.isNumber()" },
        "updatedAt":         { ".validate": "newData.isNumber()" },
        "approvedAt":        { ".validate": "newData.isNumber()" },
        "approvedBy":        { ".validate": "newData.isString()" },
        "rejectionReason":   { ".validate": "newData.isString()" },
        "suspensionReason":  { ".validate": "newData.isString()" },
        "$other":            { ".validate": false }
      }
    },

    // ── Driver Locations ─────────────────────────────────────────────────────
    "locations": {
      // Authenticated passengers and admins can read all online locations
      ".read": "auth != null",

      "$uid": {
        // Only the driver themselves can write their own location
        ".write": "auth != null && auth.uid === $uid",

        // Validate location data
        ".validate": "newData.hasChildren(['uid','latitude','longitude','accuracy','timestamp','isOnline'])",

        "uid":       { ".validate": "newData.val() === $uid" },
        "latitude":  { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "accuracy":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "isOnline":  { ".validate": "newData.isBoolean()" },
        "$other":    { ".validate": false }
      }
    }
  }
}
